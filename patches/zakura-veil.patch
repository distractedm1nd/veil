diff --git a/crates/zakura-chain/src/block/genesis.rs b/crates/zakura-chain/src/block/genesis.rs
index 271d79142..94942a25c 100644
--- a/crates/zakura-chain/src/block/genesis.rs
+++ b/crates/zakura-chain/src/block/genesis.rs
@@ -17,3 +17,20 @@ pub fn regtest_genesis_block() -> Arc<Block> {
         .map(Arc::new)
         .expect("hard-coded Regtest genesis block data must deserialize successfully")
 }
+
+/// The fixed network genesis block, for bootstrapping an embedded headers-only node.
+/// The returned block is still checked against the configured genesis hash by consensus.
+pub fn network_genesis_block(network: &crate::parameters::Network) -> Arc<Block> {
+    if network.is_regtest() {
+        return regtest_genesis_block();
+    }
+    let hex = match network.kind() {
+        crate::parameters::NetworkKind::Mainnet => include_str!("genesis/block-main-0-000-000.txt"),
+        _ => include_str!("genesis/block-test-0-000-000.txt"),
+    };
+    Vec::from_hex(hex.trim())
+        .expect("embedded genesis hex is valid")
+        .zcash_deserialize_into()
+        .map(Arc::new)
+        .expect("embedded genesis is a serialized block")
+}

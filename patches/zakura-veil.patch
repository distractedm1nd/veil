index e5c6737d5..c124907c1 100644
--- a/crates/zakura-consensus/src/block/tests.rs
+++ b/crates/zakura-consensus/src/block/tests.rs
@@ -1233,3 +1233,33 @@ fn state_commit_context_errors_keep_misbehavior_scores() {
     let router_error = crate::router::RouterError::from(err);
     assert_eq!(router_error.misbehavior_score(), 100);
 }
+
+#[test]
+fn regtest_activation_allows_an_empty_lockbox_allocation() {
+    let network = Network::new_regtest(
+        zakura_chain::parameters::testnet::ConfiguredActivationHeights {
+            nu6_2: Some(1),
+            nu6_3: Some(2),
+            ..Default::default()
+        }
+        .into(),
+    );
+    let height = Height(1);
+    assert!(network.lockbox_disbursements(height).is_empty());
+    let block = Block {
+        header: zakura_chain::block::genesis::regtest_genesis_block()
+            .header
+            .clone(),
+        transactions: vec![Arc::new(v5_coinbase_transaction(
+            NetworkUpgrade::Nu6_2,
+            height,
+            &network,
+        ))],
+    };
+    check::subsidy_is_valid(
+        &block,
+        &network,
+        block_subsidy(height, &network).expect("regtest subsidy is defined"),
+    )
+    .expect("a private chain has no public-network lockbox allocation");
+}
